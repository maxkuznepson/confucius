# ============================================================================
# Конфигурация приложения "Школа Конфуция"
# ============================================================================

# Режим работы с данными:
#   true  = использовать MOCK-данные (локально, без сервера)
#   false = использовать реальный API (Supabase или REST)
VITE_USE_MOCK=true

# ============================================================================
# Настройки Supabase (используются когда VITE_USE_MOCK=false)
# ============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# Настройки REST API (альтернатива Supabase)
# ============================================================================
VITE_API_URL=https://api.confucius.ru
