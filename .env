# ============================================================================
# Конфигурация приложения "Школа Конфуция"
# ============================================================================

# Режим работы с данными:
#   true  = использовать MOCK-данные (локально, без сервера)
#   false = использовать реальный REST API
VITE_USE_MOCK=true

# ============================================================================
# Настройки REST API (используются когда VITE_USE_MOCK=false)
# ============================================================================
# Локальная разработка:
VITE_API_URL=http://localhost:3000/api

# Production (раскомментируйте и укажите ваш домен):
# VITE_API_URL=https://api.confucius.ru
